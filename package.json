{
  "name": "harness-benchmark",
  "version": "0.0.0",
  "private": true,
  "description": "Does a harness pay for itself? Standalone benchmark runner, evaluator and analysis.",
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "fixtures:install": "npm ci --prefix fixtures/scaffold && npm ci --prefix fixtures/references/correct",
    "reference:materialise": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/materialise.ts",
    "test:integration": "vitest run --project integration",
    "evaluate": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/evaluate.ts",
    "browsers:install": "playwright install chromium",
    "codex:preflight": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/codex-preflight.ts",
    "claude:preflight": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/claude-preflight.ts",
    "claude:store-token": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/claude-store-token.ts",
    "schedule": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/campaign.ts schedule",
    "campaign": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/campaign.ts run",
    "account": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/account.ts",
    "analyse": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/analyse.ts --figures-dir figures",
    "freeze": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/freeze.ts",
    "runner": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/runner.ts",
    "host-evidence": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/host-evidence.ts",
    "shell-preflight": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/shell-preflight.ts",
    "shell-health": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/shell-health.ts",
    "audit-block": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli/audit-block.ts",
    "diagnose": "node --disable-warning=ExperimentalWarning --experimental-strip-types post/diagnose.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.323",
    "@openai/codex": "0.169.0",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "license": "MIT"
}
