{
  "name": "job-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:server": "node --disable-warning=ExperimentalWarning dist/server.js",
    "start:worker": "node --disable-warning=ExperimentalWarning dist/worker.js",
    "check:smoke": "node --disable-warning=ExperimentalWarning --experimental-strip-types checks/cli.ts smoke",
    "check:contract": "node --disable-warning=ExperimentalWarning --experimental-strip-types checks/cli.ts contract"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
